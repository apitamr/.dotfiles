[user]
	name = apitamr
	email = 13832826+apitamr@users.noreply.github.com
[init]
	defaultBranch = main
[credential "https://github.com"]
	useHttpPath = true
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://repo.transjakarta.co.id"]
	provider = generic
