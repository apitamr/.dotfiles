[user]
	name = apitamr
	email = 13832826+apitamr@users.noreply.github.com
[init]
	defaultBranch = main
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	useHttpPath = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[pager]
	blame = delta
[delta]
	hyperlinks = true
[include]
	path = ~/.dotfiles/gitconfig/.gitconfig-work
[credential "https://codeberg.org"]
	provider = generic
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://repo.transjakarta.co.id"]
	provider = generic
